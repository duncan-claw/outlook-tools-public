<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.example.outlook-tools.groups-leaver</string>
  <key>ProcessType</key><string>Background</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/outlook-tools/.venv/bin/python</string>
    <string>/PATH/TO/outlook-tools/bin/run_groups_leaver.py</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/outlook-tools</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/PATH/TO/PRIVATE/STATE/groups-leaver/job.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/PRIVATE/STATE/groups-leaver/job-error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OUTLOOK_PERSONAL_USER</key><string>owner@example.com</string>
    <key>OUTLOOK_PERSONAL_GRAPH_CLIENT_ID</key><string>SET_LOCALLY</string>
    <key>OUTLOOK_TOOLS_STATE_DIR</key><string>/PATH/TO/PRIVATE/STATE</string>
    <key>OUTLOOK_GROUPS_STATE_DIR</key><string>/PATH/TO/PRIVATE/STATE/groups-leaver</string>
    <key>OUTLOOK_GROUPS_CDP_PORT</key><string>9222</string>
  </dict>
</dict>
</plist>
